# ========================================
# YouTube Clone - Production Environment
# ========================================
# Скопируйте этот файл в .env.production
# и измените значения на production-версии
# ========================================

# Приложение
DEBUG=False

# PostgreSQL
POSTGRES_USER=mytube_user
POSTGRES_PASSWORD=CHANGE_THIS_SECURE_PASSWORD_123
POSTGRES_DB=mytube_db
POSTGRES_PORT=5432

# Секреты (сгенерируйте новые!)
# python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=CHANGE_THIS_PRODUCTION_SECRET_KEY
CSRF_SECRET_KEY=CHANGE_THIS_PRODUCTION_CSRF_KEY

# CORS (укажите ваш домен)
CORS_ORIGINS=https://yourdomain.com

# Сессии
SESSION_COOKIE=session
SESSION_MAX_AGE=86400
SESSION_TOKEN_EXPIRE_DAYS=7

# MinIO
MINIO_ROOT_USER=CHANGE_THIS_MINIO_USER
MINIO_ROOT_PASSWORD=CHANGE_THIS_MINIO_PASSWORD
MINIO_BUCKET=videos
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001
MINIO_PUBLIC_URL=https://storage.yourdomain.com

# Nginx
NGINX_PORT=80
API_PORT=8000

# Storage fallback (если MinIO недоступен)
# STORAGE_TYPE=minio  # или filesystem
STORAGE_TYPE=minio
