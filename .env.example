# Конфигурация YouTube Clone - Локальная разработка

# Приложение
DEBUG=True

# PostgreSQL база данных
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=mytube_db
POSTGRES_PORT=5432

# Формируем DATABASE_URL из отдельных переменных
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/mytube_db

# Секретный ключ (замените на свой генерируемый в production!)
# Генерация: python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=change-this-secret-key-in-production-12345

# CSRF секрет (отдельный от SECRET_KEY)
CSRF_SECRET_KEY=change-this-csrf-secret-key-in-production

# CORS Origins
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:8000,http://localhost:8000

# Сессии
SESSION_COOKIE=session
SESSION_MAX_AGE=86400
SESSION_TOKEN_EXPIRE_DAYS=7

# MinIO объектное хранилище
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
MINIO_BUCKET=videos
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001
MINIO_PUBLIC_URL=http://localhost:9000
