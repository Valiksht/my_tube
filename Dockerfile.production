# ========================================
# YouTube Clone - Production Dockerfile
# ========================================

# Build stage
FROM python:3.13-slim AS builder

WORKDIR /build

# Устанавливаем build-зависимости
RUN apt-get update && apt-get install -y --no-install-recommends \
    gcc \
    libpq-dev \
    && rm -rf /var/lib/apt/lists/*

# Копируем и устанавливаем зависимости
COPY requirements.txt .
RUN pip install --no-cache-dir --prefix=/install -r requirements.txt


# Production stage
FROM python:3.13-slim

# Устанавливаем runtime-зависимости
RUN apt-get update && apt-get install -y --no-install-recommends \
    curl \
    libpq5 \
    postgresql-client \
    && rm -rf /var/lib/apt/lists/* \
    && apt-get clean

WORKDIR /app

# Копируем установленные пакеты из builder
COPY --from=builder /install /usr/local

# Копируем код приложения
COPY app/ ./app/
COPY alembic/ ./alembic/
COPY alembic.ini ./
COPY scripts/ ./scripts/

# Копируем entrypoint-скрипт
COPY scripts/docker_entrypoint_production.sh /docker_entrypoint_production.sh
RUN chmod +x /docker_entrypoint_production.sh

# Создаём пользователя
RUN useradd -m -s /bin/bash appuser \
    && mkdir -p /app/storage \
    && chown -R appuser:appuser /app

USER appuser

# Открываем порт
EXPOSE 8000

# Healthcheck
HEALTHCHECK --interval=30s --timeout=10s --start-period=5s --retries=3 \
    CMD curl -f http://localhost:8000/health || exit 1

# Запуск через entrypoint-скрипт
ENTRYPOINT ["/docker_entrypoint_production.sh"]
